# Kafka (KRaft)
DSM_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Privacidad / Seudonimización (cambiar en producción)
DSM_PSEUDONYM_SALT=change-me-in-production-secret-salt

# Ejecución y configuración analítica
DSM_DEFAULT_RUN_ID=run_dev_001
DSM_CONFIG_DIR=./config

# MongoDB Community
DSM_MONGO_URI=mongodb://localhost:27017
DSM_MONGO_DB=dsm_lms

# Neo4j Community
DSM_NEO4J_URI=bolt://localhost:7687
DSM_NEO4J_USER=neo4j
DSM_NEO4J_PASSWORD=dsm_neo4j_pass

# PostgreSQL
DSM_POSTGRES_DSN=postgresql://dsm_user:dsm_pass@localhost:5432/dsm_metadata

# C2 Ingestion Gateway
DSM_GATEWAY_HOST=0.0.0.0
DSM_GATEWAY_PORT=8000
DSM_GATEWAY_URL=http://localhost:8000
